{
  "name": "luxury-furniture-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:large": "tsx src/scripts/seed-large.ts",
    "db:init": "tsx src/scripts/database.ts init",
    "db:setup": "npm run db:init && npm run seed -- --if-empty",
    "db:indexes:apply": "tsx src/scripts/database.ts apply",
    "db:indexes:drop": "tsx src/scripts/database.ts drop",
    "db:indexes:status": "tsx src/scripts/database.ts status",
    "test:core": "tsx src/scripts/test-core.ts",
    "test:customer": "tsx src/scripts/test-customer-extended.ts",
    "test:sales": "tsx src/scripts/test-sales.ts",
    "test:admin": "tsx src/scripts/test-admin.ts",
    "test:api": "tsx src/scripts/test-api.ts",
    "test:smoke": "npm run test:core && npm run test:customer && npm run test:sales && npm run test:admin && npm run test:api",
    "test:concurrency": "tsx src/scripts/test-concurrency.ts",
    "test:all": "npm run test:smoke && npm run test:concurrency"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}

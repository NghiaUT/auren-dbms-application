# ============================================================================
# File: backend/.env.example
# Vai trò: Mẫu khai báo các biến môi trường cần thiết cho Backend:
#   - Cấu hình cổng HTTP Server (PORT)
#   - Thông tin kết nối MySQL (DB_HOST, DB_USER, DB_PASS, DB_NAME)
#   - Cấu hình xác thực JWT (JWT_SECRET, JWT_EXPIRES_IN)
#   - Cấu hình bảo mật CORS (CORS_ORIGIN)
# ============================================================================
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=luxury_furniture
JWT_SECRET=replace-with-your-local-secret
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
